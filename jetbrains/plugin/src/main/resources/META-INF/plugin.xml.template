<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>so.matterai.jetbrains</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>Axon Code</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://matterai.so">Axon Code</vendor>

    <!-- Resource bundles for internationalization -->
    <resource-bundle>messages.JetbrainsBundle</resource-bundle>
    <resource-bundle>messages.AxonCodeBundle</resource-bundle>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
        <h1>Orbital AI Coding Agent | AI Code Reviews</h1>
        <p>AI coding agent for planning, building, and fixing code with AI Code Review, by MatterAI</p>
   ]]></description>
   
   <!-- Change notes for the plugin -->
   <change-notes><![CDATA[
{{CHANGE_NOTES}}
    ]]></change-notes>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>
    
    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="so.matterai.jetbrains.plugin.WecoderPluginService"/>
        <jbProtocolCommand implementation="so.matterai.jetbrains.commands.AxonCodeAuthProtocolCommand" />
        <postStartupActivity implementation="so.matterai.jetbrains.plugin.WecoderPlugin"/>
        <editorFactoryListener implementation="so.matterai.jetbrains.editor.EditorListener"/>
        <toolWindow factoryClass="so.matterai.jetbrains.ui.RooToolWindowFactory"
                    id="Orbital"
                    secondary="true"
                    icon="/icons/kilo-dark.svg"
                    anchor="right" />
        <notificationGroup
                    id="axoncode"
                    displayType="BALLOON"
        />
        <checkinHandlerFactory implementation="so.matterai.jetbrains.git.CommitMessageHandlerFactory"/>
        <applicationService serviceImplementation="so.matterai.jetbrains.git.CommitMessageService"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.terminal">
        <localTerminalCustomizer implementation="so.matterai.jetbrains.terminal.WeCoderTerminalCustomizer"/>
    </extensions>

    <actions>
        <action id="axoncode.plusButtonClicked"
                icon="AllIcons.General.Add"
                class="so.matterai.jetbrains.actions.PlusButtonClickAction"
                text="${action.newTask}"
                description="${action.newTask.description}">
            <override-text place="GoToAction" text="${action.newTask}" />
        </action>

        <action id="axoncode.mcpButtonClicked"
                icon="AllIcons.Webreferences.Server"
                class="so.matterai.jetbrains.actions.MCPButtonClickAction"
                text="${action.mcpServer}"
                description="${action.mcpServer.description}">
            <override-text place="GoToAction" text="${action.mcpServer}" />
        </action>

        <action id="axoncode.historyButtonClicked"
                icon="AllIcons.Vcs.History"
                class="so.matterai.jetbrains.actions.HistoryButtonClickAction"
                text="${action.history}"
                description="${action.history.description}">
            <override-text place="GoToAction" text="${action.history}" />
        </action>

        <action id="axoncode.profileButtonClicked"
                icon="AllIcons.General.User"
                class="so.matterai.jetbrains.actions.ProfileButtonClickAction"
                text="${action.profile}"
                description="${action.profile.description}">
            <override-text place="GoToAction" text="${action.profile}" />
        </action>

        <action id="axoncode.settingsButtonClicked"
                icon="AllIcons.General.Settings"
                class="so.matterai.jetbrains.actions.SettingsButtonClickAction"
                text="${action.settings}"
                description="${action.settings.description}">
            <override-text place="GoToAction" text="${action.settings}" />
        </action>

        <action id="axoncode.generateCommitMessage"
                icon="/icons/matterai-ic.svg"
                class="so.matterai.jetbrains.actions.GitCommitMessageAction"
                text="${action.generateCommitMessage}"
                description="${action.generateCommitMessage.description}">
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="first"/>
        </action>

        <group id="WecoderToolbarGroup">
            <reference ref="axoncode.plusButtonClicked" />
            <reference ref="axoncode.mcpButtonClicked" />
            <reference ref="axoncode.historyButtonClicked" />
            <reference ref="axoncode.profileButtonClicked" />
            <reference ref="axoncode.settingsButtonClicked" />
        </group>

        <group id="axoncode.RightClickMenu" text="${menu.axonCode}" description="${menu.axoncodeMainMenu}"  icon="/icons/matterai-ic.svg" popup="true">
            <group id="axoncode.RightClick.Chat" class="so.matterai.jetbrains.actions.RightClickChatActionGroup"
                   text="${menu.chat}" description="${menu.axoncodeChatTool}"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </group>
    </actions>
</idea-plugin>